alias drl='docker run --privileged -it --rm --gpus all -v ~/logdir:/logdir image'

# List files after changing directory
cd() {
  builtin cd "$@" && l
}

ed() {
  # Edit folder hierarchy using Vim.
  if [ -z "$1" ]; then; 1=$PWD; fi
  ~/bin/edit_list \
      --content-cmd "find $1" \
      --rename-cmd 'mv {} {}' \
      --delete-cmd 'rm -rf {}'
}

gw() {
  # Switches to a branch in a git worktree for the current repository. Creates
  # the worktree and branch as needed.
  local branch=$1
  [[ -n $branch ]] || { echo "usage: $0 <branch-name|pr-number>"; return 1; }
  local main
  main=${$(git rev-parse --path-format=absolute --git-common-dir):h} || return 1
  git -C $main fetch origin || return 1
  if [[ $branch =~ ^[0-9]+$ ]]; then
    branch=$(gh pr view $1 --json headRefName -q .headRefName) || return 1
    git -C $main fetch origin "pull/$1/head:refs/remotes/origin/$branch" || return 1
  fi
  # Slashes in branch names would create nested directories.
  local dir=${main:h}/${main:t}.${branch//\//-}
  if [[ ! -d $dir ]]; then
    if git -C $main show-ref --verify --quiet refs/heads/$branch; then
      git -C $main worktree add $dir $branch
    elif git -C $main show-ref --verify --quiet refs/remotes/origin/$branch; then
      git -C $main worktree add -b $branch $dir origin/$branch
    else
      git -C $main worktree add --no-track -b $branch $dir origin/main
    fi || return 1
  fi
  cd $dir
}

gt() {
  # Opens a tmux window in session "main" with a git worktree for a branch or
  # PR number. Creates the session, worktree, branch, and window as needed.
  [[ -n $1 ]] || { echo "usage: $0 <branch-name|pr-number>"; return 1; }
  # Subshell keeps the caller's directory unchanged.
  local dir
  dir=$(gw $1 >&2 && pwd) || return 1
  # Create the session around this worktree so there is no leftover window.
  local win left
  if tmux has-session -t main 2>/dev/null; then
    # Match windows by a custom option because window names can get renamed.
    win=$(tmux list-windows -t main -f "#{==:#{@worktree},$dir}" -F '#{window_id}')
  else
    left=$(tmux new-session -d -P -F '#{pane_id}' -s main -n ${dir:t} -c $dir 'claude; exec $SHELL')
  fi
  if [[ -z $win ]]; then
    [[ -n $left ]] || left=$(tmux new-window -d -P -F '#{pane_id}' -t main: -n ${dir:t} -c $dir 'claude; exec $SHELL')
    tmux set-option -w -t $left @worktree $dir
    tmux split-window -h -d -t $left -c $dir 'nvim; exec $SHELL'
    tmux split-window -v -d -t $left -c $dir 'command ls --color=auto --group-directories-first -lhA --time-style long-iso; exec $SHELL'
    win=$(tmux display-message -p -t $left '#{window_id}')
  fi
  if [[ -n $TMUX ]]; then
    tmux switch-client -t $win
  else
    tmux select-window -t $win
    tmux attach -t main
  fi
}
